# Copy to .env and fill in. Loaded by the LLM provider layer.

# Required for remote LLM/embedding calls (extract_visuals, distill, kb).
OPENAI_API_KEY=sk-...

# Optional: use Google Gemini for the vision stage instead of gpt-4o
# (cheaper per frame on long videos). Set the provider to "gemini" and
# supply a key; leave the provider as "openai" to ignore this entirely.
# VIDEODISTILL_VISION_PROVIDER=gemini
# GEMINI_API_KEY=...

# Optional overrides (sane local defaults live in videodistill/config.py).
# VIDEODISTILL_ASR_MODEL=small
# VIDEODISTILL_VISION_MODEL=gpt-4o          # or gemini-3.1-flash-lite when provider=gemini
# VIDEODISTILL_DISTILL_MODEL=gpt-4o-mini
# VIDEODISTILL_EMBED_MODEL=text-embedding-3-small
# VIDEODISTILL_CACHE_DIR=.cache
# VIDEODISTILL_VECTOR_STORE=qdrant          # KB backend (embedded Qdrant by default)
